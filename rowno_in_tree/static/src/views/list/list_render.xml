<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!--
        Cách hoạt động:
        1. Patch base `web.ListRenderer` (extension): chèn <th>#</th> vào thead
           sau cột selector, chèn <td/> vào tfoot tương ứng.
        2. Patch base `web.ListRenderer.RecordRow` (extension): chèn <td> với
           `record_index + 1` (biến do t-foreach của Rows sinh sẵn) — bền hơn
           t-set RowNumber vì t-set trong t-foreach không persist cross-iteration.
        3. Với mỗi renderer dùng `t-inherit-mode="primary"` (Odoo tạo bản sao
           độc lập của template gốc), phải patch lại extension trên CHÍNH primary
           đó, nếu không header/body lệch một cột (xem ảnh bug ở stock.picking).
           Chỉ liệt kê những primary có trong module đã cài ở project này.
    -->

    <!-- =============== BASE: web.ListRenderer =============== -->
    <t t-name="rowno_in_tree.ListRenderer"
       t-inherit="web.ListRenderer"
       t-inherit-mode="extension">
        <xpath expr="//thead/tr/th[1]" position="after">
            <th class="o_list_row_number_header align-middle text-center"
                tabindex="-1">#</th>
        </xpath>
        <xpath expr="//tfoot/tr/td[1]" position="after">
            <td class="o_list_row_number_footer"/>
        </xpath>
    </t>

    <t t-name="rowno_in_tree.ListRenderer.RecordRow"
       t-inherit="web.ListRenderer.RecordRow"
       t-inherit-mode="extension">
        <xpath expr="//tr/td[1]" position="after">
            <td class="o_list_row_number text-center text-muted"
                tabindex="-1">
                <span t-esc="record_index + 1"/>
            </td>
        </xpath>
    </t>

    <!-- =============== PRIMARY: account (sectionAndNote) =============== -->
