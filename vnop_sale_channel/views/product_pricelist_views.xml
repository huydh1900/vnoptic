<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_pricelist_view_tree_channel" model="ir.ui.view">
        <field name="name">product.pricelist.list.channel</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='country_group_ids']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_pricelist_view_form_channel" model="ir.ui.view">
        <field name="name">product.pricelist.form.channel</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="purchaser_id"/>
            </xpath>
            <xpath expr="//field[@name='country_group_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Thêm cột "Đang hiệu lực" vào inline list pricelist item -->
            <xpath expr="//field[@name='item_ids']/list/field[@name='date_end']" position="after">
                <field name="is_active_now" string="Đang hiệu lực"
                       decoration-success="is_active_now"
                       decoration-muted="not is_active_now"/>
            </xpath>
        </field>
    </record>

    <!-- Thêm chatter vào pricelist item form để theo dõi audit log thay đổi giá. -->
    <record id="product_pricelist_item_form_view_channel" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.channel</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="after">
                <chatter/>
            </xpath>
        </field>
    </record>

</odoo>
