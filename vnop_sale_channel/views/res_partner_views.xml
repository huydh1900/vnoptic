<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_channel" model="ir.ui.view">
        <field name="name">res.partner.form.channel</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="supplier_rank" invisible="1" force_save="1"/>
            </xpath>
            <xpath expr="//field[@id='company']" position="attributes">
                <attribute name="placeholder">VD: Công ty TNHH ABC</attribute>
            </xpath>
            <xpath expr="//field[@id='individual']" position="attributes">
                <attribute name="placeholder">VD: Nguyễn Văn A</attribute>
            </xpath>
            <xpath expr="(//field[@name='street2'])[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="(//field[@name='street2'])[2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']//group[@name='misc']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']//group[@name='fiscal_information']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='sales_purchases']//group[@name='container_row_2']" position="inside">
                <group string="Đại lý kính mắt" name="dealer_info">
                    <field name="dealer_tier_id"/>
                    <field name="credit_limit"/>
                    <field name="credit"/>
                    <field name="credit_used_pct" widget="progressbar"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_customer" model="ir.ui.view">
        <field name="name">res.partner.form.customer</field>
        <field name="model">res.partner</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <field name="ref" position="attributes">
                <attribute name="string">Mã khách hàng</attribute>
            </field>
        </field>
    </record>

    <record id="view_partner_tree_customer" model="ir.ui.view">
        <field name="name">res.partner.list.customer</field>
        <field name="model">res.partner</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <field name="complete_name" position="after">
                <field name="ref" string="Mã khách hàng" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_res_partner_filter_customer" model="ir.ui.view">
        <field name="name">res.partner.search.customer</field>
        <field name="model">res.partner</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- View primary clone không nhận extension của vnop_partner (thêm field ref
                 vào search base), nên phải tự thêm field ref ở đây thay vì position="attributes". -->
            <field name="name" position="after">
                <field name="ref" string="Mã khách hàng"/>
            </field>
        </field>
    </record>

    <record id="account.res_partner_action_customer" model="ir.actions.act_window">
        <field name="domain">[('customer_rank', '>', 0)]</field>
        <field name="search_view_id" ref="view_res_partner_filter_customer"/>
    </record>

    <record id="customer_action_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_partner_tree_customer"/>
        <field name="act_window_id" ref="account.res_partner_action_customer"/>
    </record>

    <record id="customer_action_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_partner_form_customer"/>
        <field name="act_window_id" ref="account.res_partner_action_customer"/>
    </record>

    <record id="account.res_partner_action_supplier" model="ir.actions.act_window">
        <field name="domain">[('supplier_rank', '>', 0)]</field>
    </record>

</odoo>
