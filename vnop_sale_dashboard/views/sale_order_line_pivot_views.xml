<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pivot: Top 10 sản phẩm -->
    <record id="view_sale_order_line_top_product_pivot" model="ir.ui.view">
        <field name="name">sale.order.line.top.product.pivot</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Top sản phẩm">
                <field name="product_id" type="row"/>
                <field name="price_subtotal" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Action: Top 10 sản phẩm -->
    <record id="action_sale_order_line_top_product" model="ir.actions.act_window">
        <field name="name">Top sản phẩm</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_sale_order_line_top_product_pivot"/>
        <field name="domain">[('order_id.state','in',['sale','done'])]</field>
        <field name="limit">10</field>
        <field name="context">{'search_default_this_year': 1}</field>
    </record>

</odoo>
