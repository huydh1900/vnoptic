<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company rule: vnop.sale.report.channel -->
        <record id="rule_vnop_sale_report_channel_company" model="ir.rule">
            <field name="name">Báo cáo doanh thu: giới hạn theo công ty</field>
            <field name="model_id" ref="model_vnop_sale_report_channel"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Multi-company rule: vnop.sale.report.aging -->
        <record id="rule_vnop_sale_report_aging_company" model="ir.rule">
            <field name="name">Báo cáo tuổi nợ: giới hạn theo công ty</field>
            <field name="model_id" ref="model_vnop_sale_report_aging"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
