<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view -->
    <record id="vnop_sale_target_view_form" model="ir.ui.view">
        <field name="name">vnop.sale.target.view.form</field>
        <field name="model">vnop.sale.target</field>
        <field name="arch" type="xml">
            <form string="Mục tiêu doanh số">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Thông tin kỳ">
                            <field name="user_id"/>
                            <field name="period_type"/>
                            <field name="period_ref_date" string="Ngày tham chiếu"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Doanh số">
                            <field name="target_amount"/>
                            <field name="actual_amount" readonly="1"/>
                            <field name="achievement_pct" readonly="1"
                                   widget="percentage"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="vnop_sale_target_view_list" model="ir.ui.view">
        <field name="name">vnop.sale.target.view.list</field>
        <field name="model">vnop.sale.target</field>
        <field name="arch" type="xml">
            <list string="Mục tiêu doanh số"
                  decoration-success="achievement_pct &gt;= 100"
                  decoration-warning="achievement_pct &gt;= 80 and achievement_pct &lt; 100"
                  decoration-danger="achievement_pct &lt; 80">
                <field name="name"/>
                <field name="user_id"/>
                <field name="period_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="target_amount"/>
                <field name="actual_amount"/>
                <field name="achievement_pct" string="Đạt (%)" widget="percentage"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Search view -->
    <record id="vnop_sale_target_view_search" model="ir.ui.view">
        <field name="name">vnop.sale.target.view.search</field>
        <field name="model">vnop.sale.target</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm mục tiêu doanh số">
                <field name="user_id" string="Nhân viên"/>
                <field name="name" string="Tên"/>
                <filter name="filter_month" string="Theo tháng" domain="[('period_type','=','month')]"/>
                <filter name="filter_quarter" string="Theo quý" domain="[('period_type','=','quarter')]"/>
                <filter name="filter_year" string="Theo năm" domain="[('period_type','=','year')]"/>
                <separator/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_user" string="Nhân viên" context="{'group_by': 'user_id'}"/>
                    <filter name="group_period" string="Loại kỳ" context="{'group_by': 'period_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vnop_sale_target" model="ir.actions.act_window">
        <field name="name">Mục tiêu doanh số</field>
        <field name="res_model">vnop.sale.target</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="vnop_sale_target_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có mục tiêu doanh số nào.
            </p>
            <p>Tạo mục tiêu doanh số cho nhân viên theo tháng, quý hoặc năm.</p>
        </field>
    </record>

</odoo>
