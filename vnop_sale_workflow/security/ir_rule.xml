<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- RMA: Multi-company rule -->
        <record id="rule_rma_company" model="ir.rule">
            <field name="name">RMA: chỉ xem theo công ty</field>
            <field name="model_id" ref="model_vnop_rma"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Sale Target: Multi-company rule -->
        <record id="rule_sale_target_company" model="ir.rule">
            <field name="name">Mục tiêu doanh số: chỉ xem theo công ty</field>
            <field name="model_id" ref="model_vnop_sale_target"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
