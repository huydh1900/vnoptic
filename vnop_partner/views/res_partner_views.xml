<?xml version="1.0"?>
<odoo>
    <record id="vnoptic_view_partner_form_inherit" model="ir.ui.view">
        <field name="name">vnoptic.view.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group/group[2]/field[@name='category_id']" position="replace"/>
            <xpath expr="//form/sheet/group/group[2]/field[@name='lang']" position="replace"/>
            <xpath expr="//form/sheet/group/group[2]/field[@name='title']" position="replace"/>
            <xpath expr="//form/sheet/group/group[2]/field[@name='website']" position="replace"/>
            <xpath expr="//form/sheet/group/group[2]/field[@name='function']" position="replace"/>
            <field name="vat" position="after">
                <field name="ref"/>
            </field>
            <xpath expr="(//field[@name='state_id'])[1]" position="attributes">
                <attribute name="string">Tỉnh</attribute>
                <attribute name="placeholder">Tỉnh</attribute>
            </xpath>
            <xpath expr="(//field[@name='state_id'])[2]" position="attributes">
                <attribute name="string">Tỉnh</attribute>
                <attribute name="placeholder">Tỉnh</attribute>
            </xpath>
            <xpath expr="(//field[@name='state_id'])[3]" position="attributes">
                <attribute name="string">Tỉnh</attribute>
                <attribute name="placeholder">Tỉnh</attribute>
            </xpath>
            <xpath expr="(//span[@name='address_name'])[1]" position="replace"/>
            <xpath expr="(//div[hasclass('o_address_format')])[1]" position="replace">
                <field name="vat" string="Mã số thuế" placeholder="Mã số thuế" readonly="parent_id"/>
                <field name="country_id" string="Quốc gia" placeholder="Chọn quốc gia"
                       options='{"no_open": True, "no_create": True}'
                       readonly="type == 'contact' and parent_id"/>
                <field name="state_id" string="Tỉnh/Thành phố" placeholder="Chọn Tỉnh/Thành phố"
                       options="{'no_open': True, 'no_quick_create': True}"
                       readonly="type == 'contact' and parent_id"
                       context="{'country_id': country_id, 'default_country_id': country_id}"/>
                <field name="ward_id" string="Phường/Xã" placeholder="Chọn Phường/Xã"
                       options="{'no_open': True, 'no_create': True}"
                       domain="[('state_id', '=', state_id)]"
                       readonly="type == 'contact' and parent_id"/>
                <field name="street" string="Địa chỉ cụ thể" placeholder="Số nhà, tên đường..."
                       readonly="type == 'contact' and parent_id"/>
                <field name="city" invisible="1"/>
                <field name="street2" invisible="1"/>
                <field name="zip" invisible="1"/>
            </xpath>
            <xpath expr="(//field[@name='vat'])[last()]" position="replace"/>
            <xpath expr="(//field[@name='mobile'])[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="vnoptic_view_partner_tree_inherit" model="ir.ui.view">
        <field name="name">vnoptic.view.partner.tree.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="user_id" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="activity_ids" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="city" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="vnoptic_view_partner_search_inherit" model="ir.ui.view">
        <field name="name">vnoptic.view.partner.search.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="ref"/>
            </field>
        </field>
    </record>
</odoo>