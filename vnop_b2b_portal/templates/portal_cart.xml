<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_cart" name="B2B Cart">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'b2b_cart'"/>

            <div class="container mt-3">
                <h3 class="mb-3">Giỏ hàng</h3>

                <t t-if="cart_lines">
                    <form action="/my/cart/update" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="table-responsive mb-3">
                            <table class="table table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th class="text-end" style="width: 120px;">Đơn giá</th>
                                        <th class="text-center" style="width: 120px;">Số lượng</th>
                                        <th class="text-end" style="width: 140px;">Thành tiền</th>
                                        <th class="text-center" style="width: 80px;">Xóa</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="cart_lines" t-as="line">
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">
                                                    <t t-out="line['product'].display_name"/>
                                                </div>
                                                <small class="text-muted">
                                                    <t t-out="line['product'].default_code or ''"/>
                                                </small>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="'%s %s' % ('{:,.0f}'.format(line['price_unit']), currency.symbol)"/>
                                            </td>
                                            <td class="text-center">
                                                <input type="number"
                                                       t-attf-name="qty_{{ line['product'].id }}"
                                                       t-att-value="line['qty']"
                                                       min="0" class="form-control form-control-sm text-center"
                                                       style="max-width: 90px; margin: auto;"/>
                                            </td>
                                            <td class="text-end fw-bold">
                                                <t t-out="'%s %s' % ('{:,.0f}'.format(line['subtotal']), currency.symbol)"/>
                                            </td>
                                            <td class="text-center">
                                                <input type="hidden"
                                                       t-attf-name="qty_{{ line['product'].id }}"
                                                       t-att-value="line['qty']"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
                                        <td class="text-end fw-bold text-primary fs-5">
                                            <t t-out="'%s %s' % ('{:,.0f}'.format(cart_total), currency.symbol)"/>
                                        </td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <a href="/my/catalog" class="btn btn-outline-secondary">
                                <i class="fa fa-arrow-left me-1"/>Tiếp tục mua hàng
                            </a>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-secondary">
                                    <i class="fa fa-refresh me-1"/>Cập nhật giỏ hàng
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Checkout form -->
                    <div class="d-flex justify-content-end mt-3">
                        <form action="/my/cart/checkout" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fa fa-check me-1"/>Đặt hàng
                            </button>
                        </form>
                    </div>
                </t>

                <t t-else="">
                    <div class="text-center py-5">
                        <i class="fa fa-shopping-cart fa-4x text-muted mb-3"/>
                        <h5 class="text-muted">Giỏ hàng trống</h5>
                        <a href="/my/catalog" class="btn btn-primary mt-2">
                            <i class="fa fa-th me-1"/>Xem danh mục sản phẩm
                        </a>
                    </div>
                </t>
            </div>
        </t>
    </template>

</odoo>
