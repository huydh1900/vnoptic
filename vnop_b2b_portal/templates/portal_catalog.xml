<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_catalog" name="B2B Catalog">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'b2b_catalog'"/>

            <div class="container mt-3">
                <h3 class="mb-3">Danh mục sản phẩm</h3>

                <!-- Search + Filter -->
                <form method="get" action="/my/catalog" class="row g-2 mb-4">
                    <div class="col-12 col-md-6">
                        <div class="input-group">
                            <input type="text" name="search" class="form-control"
                                   placeholder="Tìm kiếm sản phẩm..."
                                   t-att-value="search or ''"/>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-search"/>
                            </button>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <select name="category_id" class="form-select" onchange="this.form.submit()">
                            <option value="">-- Tất cả danh mục --</option>
                            <t t-foreach="categories" t-as="cat">
                                <option t-att-value="cat.id"
                                        t-att-selected="cat.id == category_id and 'selected' or False">
                                    <t t-out="cat.display_name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                    <t t-if="search or category_id">
                        <div class="col-12 col-md-2">
                            <a href="/my/catalog" class="btn btn-outline-secondary w-100">
                                <i class="fa fa-times me-1"/>Xóa bộ lọc
                            </a>
                        </div>
                    </t>
                </form>

                <!-- Product grid -->
                <t t-if="product_lines">
                    <div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
                        <t t-foreach="product_lines" t-as="line">
                            <div class="col">
                                <div class="card h-100 shadow-sm">
                                    <t t-if="line['product'].image_128">
                                        <img t-attf-src="/web/image/product.product/{{ line['product'].id }}/image_128"
                                             class="card-img-top p-2"
                                             style="height: 140px; object-fit: contain;"
                                             t-att-alt="line['product'].display_name"/>
                                    </t>
                                    <div class="card-body d-flex flex-column">
                                        <p class="card-text text-muted small mb-1">
                                            <t t-out="line['product'].default_code or ''"/>
                                        </p>
                                        <h6 class="card-title flex-grow-1">
                                            <t t-out="line['product'].display_name"/>
                                        </h6>
                                        <p class="card-text fw-bold text-primary">
                                            <t t-out="'%s %s' % ('{:,.0f}'.format(line['price']), currency.symbol)"/>
                                        </p>
                                        <form action="/my/cart/add" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="product_id" t-att-value="line['product'].id"/>
                                            <div class="input-group input-group-sm">
                                                <input type="number" name="qty" value="1" min="1"
                                                       class="form-control" style="max-width: 70px;"/>
                                                <button type="submit" class="btn btn-primary btn-sm">
                                                    <i class="fa fa-cart-plus me-1"/>Thêm
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Pager -->
                    <t t-call="portal.pager" t-if="pager['page_count'] > 1">
                        <t t-set="pager" t-value="pager"/>
                    </t>
                </t>

                <t t-else="">
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle me-2"/>Không tìm thấy sản phẩm nào phù hợp.
                    </div>
                </t>
            </div>
        </t>
    </template>

</odoo>
