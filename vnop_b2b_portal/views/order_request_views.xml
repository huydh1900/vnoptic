<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vnop_order_request_list" model="ir.ui.view">
        <field name="name">vnop.order.request.list</field>
        <field name="model">vnop.order.request</field>
        <field name="arch" type="xml">
            <list string="Đơn yêu cầu B2B" decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'submitted'"
                  decoration-success="state == 'quoted'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_request"/>
                <field name="user_id"/>
                <field name="amount_total" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="sale_order_count" string="SL báo giá"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'quoted'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_vnop_order_request_form" model="ir.ui.view">
        <field name="name">vnop.order.request.form</field>
        <field name="model">vnop.order.request</field>
        <field name="arch" type="xml">
            <form string="Đơn yêu cầu B2B">
                <header>
                    <button name="action_submit" type="object"
                            string="Gửi yêu cầu" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_create_quotation" type="object"
                            string="Tạo báo giá" class="oe_highlight"
                            invisible="state not in ('submitted', 'quoted')"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Đưa về nháp"
                            invisible="state not in ('submitted', 'cancelled')"/>
                    <button name="action_cancel" type="object"
                            string="Hủy"
                            invisible="state in ('cancelled', 'quoted')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,quoted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_quotations" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="sale_order_count == 0">
                            <field name="sale_order_count" widget="statinfo"
                                   string="Báo giá"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="user_id"/>
                            <field name="date_request"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="pricelist_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sản phẩm">
                            <field name="line_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"
                                           options="{'no_create': True}"/>
                                    <field name="name"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom"
                                           groups="uom.group_uom"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal" widget="monetary"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_total"
                                       widget="monetary"
                                       class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Ghi chú">
                            <field name="note" placeholder="Ghi chú nội bộ..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vnop_order_request_search" model="ir.ui.view">
        <field name="name">vnop.order.request.search</field>
        <field name="model">vnop.order.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="filter_draft" string="Nháp"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_submitted" string="Đã gửi"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_quoted" string="Đã báo giá"
                        domain="[('state', '=', 'quoted')]"/>
                <filter name="filter_my" string="Của tôi"
                        domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_partner" string="Đại lý"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Trạng thái"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Nhân viên"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vnop_order_request" model="ir.actions.act_window">
        <field name="name">Phiếu nhu cầu mua</field>
        <field name="res_model">vnop.order.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vnop_order_request_search"/>
        <field name="context">{'search_default_filter_submitted': 1}</field>
    </record>

    <menuitem id="menu_vnop_order_request"
              name="Đơn đặt hàng"
              parent="sale.sale_order_menu"
              action="action_vnop_order_request"
              sequence="5"/>

    <!-- Link order_request_id trên sale.order form -->
    <record id="view_sale_order_form_b2b_request" model="ir.ui.view">
        <field name="name">sale.order.form.b2b.request</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="order_request_id" readonly="1"
                       invisible="not order_request_id"/>
            </xpath>
        </field>
    </record>

</odoo>
