<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Portal users chỉ xem đơn yêu cầu của commercial partner mình -->
        <record id="rule_portal_b2b_order_request" model="ir.rule">
            <field name="name">B2B portal own order request</field>
            <field name="model_id" ref="model_vnop_order_request"/>
            <field name="domain_force">[('commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_portal_b2b_order_request_line" model="ir.rule">
            <field name="name">B2B portal own order request line</field>
            <field name="model_id" ref="model_vnop_order_request_line"/>
            <field name="domain_force">[('request_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Portal users chỉ xem invoice/refund của commercial partner mình -->
        <record id="rule_portal_b2b_account_move" model="ir.rule">
            <field name="name">B2B portal own invoices</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[('partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id), ('move_type', 'in', ['out_invoice', 'out_refund'])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
