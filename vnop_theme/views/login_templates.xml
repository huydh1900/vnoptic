<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="utm.menu_link_tracker_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <template id="vnop_login_layout_custom" name="VNOP Login Layout">
        <t t-call="web.frontend_layout">
            <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
            <t t-set="body_classname" t-value="'bg-100 vnop-theme-login'"/>
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>

            <!--
                Inline styles cho login: workaround vì asset bundle Odoo không
                pick up vnop_theme/login.scss mặc dù manifest đã khai báo
                (load order/cache nội tại). Inline đảm bảo style luôn render.
            -->
            <style>
                .vnop-theme-login { --vnop-red-1: #970f1d; --vnop-red-2: #be2137; --vnop-red-3: #7c0914; --vnop-surface: #eceff3; --vnop-card-size: 460px; --vnop-text-dark: #182133; --vnop-text-muted: #606a7d; --vnop-border: #d9dee8; --vnop-focus: rgba(187, 34, 55, 0.2); background: var(--vnop-surface); }
                .vnop-theme-login #wrapwrap, .vnop-theme-login #wrapwrap main { min-height: 100vh; }
                .vnop-theme-login .vnop-login-page { min-height: 100vh; display: flex; flex-direction: row; align-items: center; justify-content: center; padding: 20px 14px; }
                .vnop-theme-login .vnop-login-hero { display: none !important; }
                .vnop-theme-login .vnop-login-panel { background: transparent; width: 100%; max-width: 560px; border: 0; border-radius: 0; box-shadow: none; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; }
                .vnop-theme-login .vnop-login-panel-inner { width: 100%; max-width: 540px; display: flex; justify-content: center; }
                .vnop-theme-login .vnop-login-form-card { width: 100%; max-width: 500px; min-height: auto; background: #ffffff; border: 1px solid #e4e8ef; border-radius: 22px; box-shadow: 0 18px 42px rgba(18, 28, 44, 0.14); padding: 28px 28px 24px; display: flex; flex-direction: column; justify-content: center; }
                .vnop-theme-login .vnop-login-form-logo-wrap { display: flex; justify-content: center; margin-bottom: 1rem; }
                .vnop-theme-login .vnop-login-form-logo { width: 146px; height: auto; object-fit: contain; }
                .vnop-theme-login .vnop-login-title { margin: 0; text-align: center; color: var(--vnop-text-dark); font-size: 1.62rem; font-weight: 700; line-height: 1.15; }
                .vnop-theme-login .vnop-login-subtitle { margin: 0.35rem 0 1rem; text-align: center; color: var(--vnop-text-muted); font-size: 0.92rem; line-height: 1.35; }
                .vnop-theme-login .o_user_switch { display: none !important; }
                .vnop-theme-login .oe_login_form, .vnop-theme-login .oe_signup_form, .vnop-theme-login .oe_reset_password_form { width: 100%; }
                .vnop-theme-login .oe_login_form .alert, .vnop-theme-login .oe_signup_form .alert, .vnop-theme-login .oe_reset_password_form .alert { border-radius: 10px; margin-bottom: 0.8rem; }
                .vnop-theme-login .oe_login_form .mb-3, .vnop-theme-login .oe_signup_form .mb-3, .vnop-theme-login .oe_reset_password_form .mb-3 { margin-bottom: 0.9rem !important; }
                .vnop-theme-login .vnop-forgot-password-wrap { margin-top: 0.35rem; text-align: right; }
                .vnop-theme-login .vnop-forgot-password-wrap .btn-link { padding: 0; font-size: 0.85rem; }
                .vnop-theme-login .oe_login_form label, .vnop-theme-login .oe_signup_form label, .vnop-theme-login .oe_reset_password_form label { color: #3c4658; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.35rem; }
                .vnop-theme-login .oe_login_form .form-control, .vnop-theme-login .oe_login_form .form-control-sm, .vnop-theme-login .oe_signup_form .form-control, .vnop-theme-login .oe_signup_form .form-control-sm, .vnop-theme-login .oe_reset_password_form .form-control, .vnop-theme-login .oe_reset_password_form .form-control-sm { min-height: 46px; border: 1px solid var(--vnop-border); border-radius: 10px; box-shadow: none; color: #253049; font-size: 0.96rem; padding: 0.55rem 0.82rem; width: 100%; background: #fff; font-family: inherit; }
                .vnop-theme-login .vnop-password-wrap { position: relative; }
                .vnop-theme-login .vnop-password-wrap .form-control, .vnop-theme-login .vnop-password-wrap .form-control-sm { padding-right: 2.8rem; }
                .vnop-theme-login .vnop-password-toggle { position: absolute; top: 50%; right: 0.55rem; transform: translateY(-50%); border: 0; background: transparent; color: #7f889a; width: 30px; height: 30px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; }
                .vnop-theme-login .vnop-password-toggle:hover, .vnop-theme-login .vnop-password-toggle:focus { color: #243048; background: rgba(36, 48, 72, 0.08); }
                .vnop-theme-login .oe_login_form .form-control::placeholder, .vnop-theme-login .oe_login_form .form-control-sm::placeholder, .vnop-theme-login .oe_signup_form .form-control::placeholder, .vnop-theme-login .oe_signup_form .form-control-sm::placeholder, .vnop-theme-login .oe_reset_password_form .form-control::placeholder, .vnop-theme-login .oe_reset_password_form .form-control-sm::placeholder { color: #8c96a9; }
                .vnop-theme-login .oe_login_form .form-control:focus, .vnop-theme-login .oe_login_form .form-control-sm:focus, .vnop-theme-login .oe_signup_form .form-control:focus, .vnop-theme-login .oe_signup_form .form-control-sm:focus, .vnop-theme-login .oe_reset_password_form .form-control:focus, .vnop-theme-login .oe_reset_password_form .form-control-sm:focus { border-color: #bf2a3f; box-shadow: 0 0 0 0.2rem var(--vnop-focus); outline: none; }
                .vnop-theme-login .oe_login_form .oe_login_buttons, .vnop-theme-login .oe_signup_form .oe_login_buttons, .vnop-theme-login .oe_reset_password_form .oe_login_buttons { margin-top: 0.35rem; }
                .vnop-theme-login .oe_login_form .btn-primary, .vnop-theme-login .oe_signup_form .btn-primary, .vnop-theme-login .oe_reset_password_form .btn-primary { width: 100%; min-height: 48px; border-radius: 10px; border: 1px solid #a71a2f; background: linear-gradient(180deg, #c42a3f 0%, #af1830 100%); color: #ffffff; font-size: 0.98rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; box-shadow: 0 8px 18px rgba(158, 22, 40, 0.22); cursor: pointer; }
                .vnop-theme-login .oe_login_form .btn-primary:hover, .vnop-theme-login .oe_login_form .btn-primary:focus, .vnop-theme-login .oe_signup_form .btn-primary:hover, .vnop-theme-login .oe_signup_form .btn-primary:focus, .vnop-theme-login .oe_reset_password_form .btn-primary:hover, .vnop-theme-login .oe_reset_password_form .btn-primary:focus { border-color: #940f24; background: linear-gradient(180deg, #b72338 0%, #951024 100%); }
                .vnop-theme-login .oe_login_form a, .vnop-theme-login .oe_signup_form a, .vnop-theme-login .oe_reset_password_form a { color: #9e1a31; text-decoration: none; font-weight: 600; }
                .vnop-theme-login .oe_login_form a:hover, .vnop-theme-login .oe_login_form a:focus, .vnop-theme-login .oe_signup_form a:hover, .vnop-theme-login .oe_signup_form a:focus, .vnop-theme-login .oe_reset_password_form a:hover, .vnop-theme-login .oe_reset_password_form a:focus { color: #7f1023; text-decoration: underline; }
                @media (max-width: 991.98px) { .vnop-theme-login .vnop-login-page { padding: 16px; } .vnop-theme-login .vnop-login-panel { max-width: 520px; } .vnop-theme-login .vnop-login-form-card { max-width: 520px; } }
                @media (max-width: 575.98px) { .vnop-theme-login .vnop-login-panel { max-width: 100%; } .vnop-theme-login .vnop-login-form-card { border-radius: 16px; padding: 18px 14px; } .vnop-theme-login .vnop-login-form-logo { width: 128px; } .vnop-theme-login .vnop-login-subtitle { margin-bottom: 0.75rem; font-size: 0.88rem; } }
            </style>

            <div class="vnop-login-page">
                <section class="vnop-login-panel o_database_list">
                    <div class="vnop-login-panel-inner">
                        <div class="vnop-login-form-card">
                            <div class="vnop-login-form-logo-wrap">
                                <img class="vnop-login-form-logo" src="/vnop_theme/static/src/img/image.png" alt="VNOPTIC Logo"/>
                            </div>

                            <h2 class="vnop-login-title">
                                <t t-esc="vnop_auth_title or 'Đăng nhập'"/>
                            </h2>
                            <p class="vnop-login-subtitle" t-if="vnop_auth_subtitle">
                                <t t-esc="vnop_auth_subtitle"/>
                            </p>

                            <t t-out="0"/>
                        </div>
                    </div>
                </section>
            </div>

            <!--
                Inline script: cùng lý do với inline style — asset bundle có
                thể không pick up vnop_theme/static/src/js/password_toggle.js,
                nên gắn trực tiếp toggle eye icon ở đây để luôn hoạt động.
                Flag data-vnop-toggle-ready chống chạy 2 lần nếu asset cũng load.
            -->
            <script type="text/javascript">
                <![CDATA[
                (function () {
                    function setupPasswordToggle(input) {
                        if (!input || input.dataset.vnopToggleReady === "1") { return; }
                        input.dataset.vnopToggleReady = "1";
                        var wrapper = document.createElement("div");
                        wrapper.className = "vnop-password-wrap";
                        var parent = input.parentNode;
                        parent.insertBefore(wrapper, input);
                        wrapper.appendChild(input);
                        var btn = document.createElement("button");
                        btn.type = "button";
                        btn.className = "vnop-password-toggle";
                        btn.setAttribute("aria-label", "Hiện mật khẩu");
                        btn.setAttribute("tabindex", "-1");
                        btn.innerHTML = '<i class="fa fa-eye" aria-hidden="true"></i>';
                        btn.addEventListener("click", function () {
                            var isHidden = input.type === "password";
                            input.type = isHidden ? "text" : "password";
                            btn.setAttribute("aria-label", isHidden ? "Ẩn mật khẩu" : "Hiện mật khẩu");
                            btn.innerHTML = isHidden
                                ? '<i class="fa fa-eye-slash" aria-hidden="true"></i>'
                                : '<i class="fa fa-eye" aria-hidden="true"></i>';
                        });
                        wrapper.appendChild(btn);
                    }
                    function init() {
                        var sel = ".vnop-theme-login .oe_login_form input[type='password']," +
                                  ".vnop-theme-login .oe_signup_form input[type='password']," +
                                  ".vnop-theme-login .oe_reset_password_form input[type='password']";
                        document.querySelectorAll(sel).forEach(setupPasswordToggle);
                    }
                    if (document.readyState === "loading") {
                        document.addEventListener("DOMContentLoaded", init);
                    } else {
                        init();
                    }
                })();
                ]]>
            </script>
        </t>
    </template>

    <template id="vnop_login_use_custom_layout" name="Use custom layout for login" inherit_id="web.login" priority="90">
        <xpath expr="//t[@t-call='web.login_layout']" position="attributes">
            <attribute name="t-call">vnop_theme.vnop_login_layout_custom</attribute>
        </xpath>
        <xpath expr="//owl-component[@name='web.user_switch']" position="replace"/>
        <xpath expr="//form[contains(@t-attf-class, 'oe_login_form')]" position="attributes">
            <attribute name="t-attf-class">oe_login_form</attribute>
        </xpath>
        <xpath expr="//form[contains(@t-attf-class, 'oe_login_form')]" position="before">
            <t t-set="vnop_auth_title">Đăng Nhập</t>
        </xpath>
        <xpath expr="//label[@for='db']" position="replace">
            <label for="db" class="col-form-label">Cơ sở dữ liệu</label>
        </xpath>
        <xpath expr="//a[@href='/web/database/selector']" position="replace">
            <a role="button" href="/web/database/selector" class="btn btn-secondary">Chọn <i class="fa fa-database" role="img" aria-label="Database" title="Database"></i></a>
        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' field-login ')]/label[@for='login']" position="replace">
            <label for="login" class="form-label d-flex justify-content-between">Email *</label>
        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' field-login ')]/input[@id='login']" position="attributes">
            <attribute name="placeholder">Email</attribute>
        </xpath>
        <xpath expr="//label[@for='password']" position="replace">
            <label for="password" class="form-label d-flex justify-content-between">Mật khẩu *</label>
        </xpath>
        <xpath expr="//input[@id='password']" position="attributes">
            <attribute name="placeholder">Mật khẩu</attribute>
        </xpath>
        <xpath expr="//input[@id='password']" position="after">
            <div class="vnop-forgot-password-wrap">
                <a t-if="reset_password_enabled" class="btn btn-link btn-sm" tabindex="1" t-attf-href="/web/reset_password?{{ keep_query() }}">Quên mật khẩu?</a>
            </div>
        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' oe_login_buttons ')]/button[@type='submit' and contains(concat(' ', normalize-space(@class), ' '), ' btn-primary ')]" position="replace">
            <button type="submit" class="btn btn-primary">Đăng nhập</button>
        </xpath>
        <xpath expr="//button[@type='submit' and @name='redirect']" position="replace"/>
        <xpath expr="//p/a[contains(@t-attf-href, '/web/signup')]" position="replace"/>
    </template>

    <template id="vnop_auth_signup_fields_vi" name="Vietnamize auth signup/reset fields" inherit_id="auth_signup.fields" priority="95">
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' field-login ')]/label[@for='login']" position="replace">
            <label for="login">Email *</label>
        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' field-name ')]/label[@for='name']" position="replace">
            <label for="name">Họ và tên *</label>
        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' field-name ')]/input[@id='name']" position="attributes">
            <attribute name="placeholder">Họ và tên</attribute>
        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' field-password ')]/label[@for='password']" position="replace">
            <label for="password">Mật khẩu *</label>
        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' field-confirm_password ')]/label[@for='confirm_password']" position="replace">
            <label for="confirm_password">Xác nhận mật khẩu *</label>
        </xpath>
    </template>

    <template id="vnop_signup_use_custom_layout" name="Use custom layout for signup" inherit_id="auth_signup.signup" priority="90">
        <xpath expr="//t[@t-call='web.login_layout']" position="attributes">
            <attribute name="t-call">vnop_theme.vnop_login_layout_custom</attribute>
        </xpath>
        <xpath expr="//form[1]" position="before">
            <t t-set="vnop_auth_title">Đăng ký</t>
            <t t-set="vnop_auth_subtitle">Tạo tài khoản để bắt đầu sử dụng hệ thống</t>
        </xpath>
        <xpath expr="//form[contains(concat(' ', normalize-space(@class), ' '), ' oe_signup_form ')]//button[@type='submit' and contains(concat(' ', normalize-space(@class), ' '), ' btn-primary ')]" position="replace">
            <button type="submit" class="btn btn-primary">Đăng ký</button>
        </xpath>
        <xpath expr="//form[contains(concat(' ', normalize-space(@class), ' '), ' oe_signup_form ')]//a[contains(@t-attf-href, '/web/login')]" position="replace">
            <a t-attf-href="/web/login?{{ keep_query() }}" class="btn btn-link btn-sm" role="button">Đã có tài khoản?</a>
        </xpath>
    </template>

    <template id="vnop_reset_password_use_custom_layout" name="Use custom layout for reset password" inherit_id="auth_signup.reset_password" priority="90">
        <xpath expr="//t[@t-call='web.login_layout']" position="attributes">
            <attribute name="t-call">vnop_theme.vnop_login_layout_custom</attribute>
        </xpath>
        <xpath expr="//form[1]" position="before">
            <t t-set="vnop_auth_title">Đặt lại mật khẩu</t>
            <t t-set="vnop_auth_subtitle">Nhập email để nhận hướng dẫn tạo mật khẩu mới</t>
        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' field-login ')]/label[@for='login']" position="replace">
            <label for="login" class="col-form-label">Email *</label>
        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' field-login ')]/input[@id='login']" position="attributes">
            <attribute name="placeholder">Email</attribute>
        </xpath>
        <xpath expr="//form[contains(concat(' ', normalize-space(@class), ' '), ' oe_reset_password_form ')]//button[@type='submit' and contains(concat(' ', normalize-space(@class), ' '), ' btn-primary ')]" position="replace">
            <button type="submit" class="btn btn-primary">Đặt lại mật khẩu</button>
        </xpath>
        <xpath expr="//div[@t-if='message']/a[@href='/web/login']" position="replace">
            <a href="/web/login" class="btn btn-link btn-sm float-start" role="button">Quay lại đăng nhập</a>
        </xpath>
        <xpath expr="//form[contains(concat(' ', normalize-space(@class), ' '), ' oe_reset_password_form ')]//a[@t-if='not token']" position="replace">
            <a t-if="not token" t-attf-href="/web/login?{{ keep_query() }}">Quay lại đăng nhập</a>
        </xpath>
        <xpath expr="//form[contains(concat(' ', normalize-space(@class), ' '), ' oe_reset_password_form ')]//a[@t-if='invalid_token']" position="replace">
            <a t-if="invalid_token" href="/web/login">Quay lại đăng nhập</a>
        </xpath>
    </template>
</odoo>
