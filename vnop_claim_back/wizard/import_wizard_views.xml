<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="vnop_claim_back_import_wizard_view_form" model="ir.ui.view">
        <field name="name">vnop.claim.back.import.wizard.form</field>
        <field name="model">vnop.claim.back.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Saleout Excel">
                <sheet>
                    <group string="Thông tin chung">
                        <field name="dealer_id"/>
                        <field name="period_from"/>
                        <field name="period_to"/>
                    </group>
                    <group string="File Excel">
                        <field name="excel_file" widget="binary" filename="excel_filename"/>
                        <field name="excel_filename" invisible="1"/>
                    </group>
                    <group string="Xem trước" invisible="not parsed">
                        <field name="preview_text" nolabel="1" widget="text" readonly="1"/>
                    </group>
                    <group string="Cảnh báo / Lỗi" invisible="not error_text">
                        <field name="error_text" nolabel="1" widget="text" readonly="1"/>
                    </group>
                    <field name="parsed" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_parse" type="object" string="Kiểm tra file"
                            class="btn-secondary"/>
                    <button name="action_create" type="object" string="Tạo Claim Back"
                            class="btn-primary"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vnop_claim_back_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Saleout</field>
        <field name="res_model">vnop.claim.back.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
