<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Record rule: vnop.claim.back — lọc theo company_id của user -->
    <record id="rule_vnop_claim_back_company" model="ir.rule">
        <field name="name">Claim Back: multi-company</field>
        <field name="model_id" ref="model_vnop_claim_back"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Record rule: vnop.claim.back.line — lọc theo company_id của user -->
    <record id="rule_vnop_claim_back_line_company" model="ir.rule">
        <field name="name">Claim Back Line: multi-company</field>
        <field name="model_id" ref="model_vnop_claim_back_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
