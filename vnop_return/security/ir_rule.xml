<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale chỉ thấy phiếu mình tạo hoặc mình là Sale phụ trách -->
    <record id="rule_return_request_user_own" model="ir.rule">
        <field name="name">Sale chỉ thấy phiếu của mình</field>
        <field name="model_id" ref="model_vnop_return_request"/>
        <field name="domain_force">['|', ('salesperson_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_return_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Approvers thấy tất cả -->
    <record id="rule_return_request_approver_all" model="ir.rule">
        <field name="name">Approver thấy tất cả phiếu</field>
        <field name="model_id" ref="model_vnop_return_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_return_accountant')), (4, ref('group_return_sales_manager')), (4, ref('group_return_otk')), (4, ref('group_return_chief_accountant')), (4, ref('group_return_director'))]"/>
    </record>
</odoo>
