<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_return_button" model="ir.ui.view">
        <field name="name">sale.order.form.return.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_return_requests" type="object"
                        class="oe_stat_button" icon="fa-undo"
                        invisible="return_request_count == 0"
                        groups="vnop_return.group_return_user">
                    <field name="return_request_count" widget="statinfo"
                           string="Phiếu trả lỗi"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
