<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vnop_return_reason_list" model="ir.ui.view">
        <field name="name">vnop.return.reason.list</field>
        <field name="model">vnop.return.reason</field>
        <field name="arch" type="xml">
            <list string="Lý do trả hàng">
                <field name="name"/>
                <field name="defect_group"/>
                <field name="default_return_type"/>
                <field name="active" string="Hoạt động" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_vnop_return_reason_form" model="ir.ui.view">
        <field name="name">vnop.return.reason.form</field>
        <field name="model">vnop.return.reason</field>
        <field name="arch" type="xml">
            <form string="Lý do trả hàng">
                <sheet>
                    <widget name="web_ribbon" title="Đã lưu trữ" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active" string="Hoạt động"/>
                        </group>
                        <group>
                            <field name="defect_group" options="{'no_create': True}"/>
                            <field name="default_return_type"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Mô tả chi tiết để Sale chọn đúng lý do..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vnop_return_reason" model="ir.actions.act_window">
        <field name="name">Lý do trả hàng</field>
        <field name="res_model">vnop.return.reason</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
