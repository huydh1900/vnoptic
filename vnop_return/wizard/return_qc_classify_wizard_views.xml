<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_return_qc_classify_wizard_form" model="ir.ui.view">
        <field name="name">vnop.return.qc.classify.wizard.form</field>
        <field name="model">vnop.return.qc.classify.wizard</field>
        <field name="arch" type="xml">
            <form string="OTK phân loại hàng trả">
                <p>
                    OTK phân loại từng dòng vào <b>Kho Thương mại</b> (bán lại được)
                    hoặc <b>Kho Thanh Lý</b> (không bán lại được).
                </p>
                <field name="request_id" invisible="1"/>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="request_line_id" column_invisible="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="quantity" readonly="1"/>
                        <field name="classify_destination" required="1"/>
                        <field name="qc_note"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object"
                            string="Áp dụng &amp; tạo phiếu chuyển kho"
                            class="btn-primary"/>
                    <button special="cancel" string="Hủy" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
