<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="warranty_registration_view_tree" model="ir.ui.view">
        <field name="name">warranty.registration.tree</field>
        <field name="model">warranty.registration</field>
        <field name="arch" type="xml">
            <list string="Phiếu bảo hành">
                <field name="create_date"/>
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <field name="warranty_id"/>
                <field name="partner_id"/>
                <field name="customer_name"/>
                <field name="customer_phone"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" decoration-success="state == 'active'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="warranty_registration_view_form" model="ir.ui.view">
        <field name="name">warranty.registration.form</field>
        <field name="model">warranty.registration</field>
        <field name="arch" type="xml">
            <form string="Phiếu bảo hành">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,active,expired"/>
                </header>
                <sheet>
                    <group>
                        <group string="Phiếu">
                            <field name="token" readonly="1"/>
                            <field name="register_url" widget="url" readonly="1"/>
                            <field name="warranty_id"/>
                        </group>
                        <group string="Đơn bán">
                            <field name="sale_order_id"/>
                            <field name="sale_order_line_id" invisible="1"/>
                            <field name="product_id"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <group string="Thông tin khách cuối (sau khi đăng ký)">
                        <group>
                            <field name="customer_name"/>
                            <field name="customer_phone"/>
                            <field name="customer_email"/>
                            <field name="customer_address"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="activated_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="warranty_registration_view_search" model="ir.ui.view">
        <field name="name">warranty.registration.search</field>
        <field name="model">warranty.registration</field>
        <field name="arch" type="xml">
            <search>
                <field name="token"/>
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <field name="customer_phone"/>
                <field name="customer_name"/>
                <separator/>
                <filter name="filter_pending" string="Chờ kích hoạt"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="filter_active" string="Đã kích hoạt"
                        domain="[('state', '=', 'active')]"/>
                <filter name="filter_expired" string="Hết hạn"
                        domain="[('state', '=', 'expired')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Trạng thái"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_warranty" string="Gói bảo hành"
                            context="{'group_by': 'warranty_id'}"/>
                    <filter name="group_partner" string="Đại lý"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_warranty_registration" model="ir.actions.act_window">
        <field name="name">Phiếu bảo hành</field>
        <field name="res_model">warranty.registration</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
