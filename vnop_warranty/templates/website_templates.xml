                        <t t-if="reg.date_delivered">
                            <div class="vn-info-row">
                                <span class="k">Ngày xuất kho:</span>
                                <span class="v" t-out="reg.date_delivered.strftime('%d/%m/%Y')"/>
                            </div>
                            <div class="vn-info-row">
                                <span class="k">Hết hạn bảo hành:</span>
                                <span class="v" t-out="reg.date_wholesale_end and reg.date_wholesale_end.strftime('%d/%m/%Y') or ''"/>
                            </div>
                            <div class="vn-info-row">
                                <span class="k">Còn lại:</span>
                                <span class="v">
                                    <t t-if="reg.days_remaining_wholesale &gt; 0">
                                        <b style="color:#0e6e6b;"><t t-out="reg.days_remaining_wholesale"/> ngày</b>
                                    </t>
                                    <t t-else="">
                                        <b style="color:#b91c1c;">Đã hết hạn</b>
                                    </t>
                                </span>
                            </div>
                        </t>
                        <t t-else="">
