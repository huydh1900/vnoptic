<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Tất cả trang public bảo hành dùng layout chung
        `vnop_product_portal.vnoptic_public_layout` để giữ nhất quán UI
        với trang chi tiết sản phẩm khi quét QR.
    -->

    <!-- ============== ĐĂNG KÝ BẢO HÀNH ============== -->

    <!-- Partial: toggle "Khách lẻ" + block OTP đại lý (countdown 120s) -->
    <template id="template_warranty_dealer_otp_partial" name="OTP đại lý partial">
        <div class="vn-dealer-toggle" t-att-data-token="reg.token"
             style="display:flex; justify-content:space-between; align-items:center;
                    background:#fff; border:1px solid #e5e7eb; border-radius:6px;
                    padding:10px 14px; margin-bottom:12px;">
            <div>
                <b>Khách lẻ</b>
                <div class="sub" style="font-size:12px;color:#6b7280;">
                    Tắt nếu bạn là đại lý muốn xem BH bán buôn.
                </div>
            </div>
            <label class="vn-switch" style="position:relative;display:inline-block;width:46px;height:24px;">
                <input type="checkbox" class="vn-retail-toggle" checked="checked"
                       style="opacity:0;width:0;height:0;"/>
                <span style="position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;
                             background:#0e6e6b;border-radius:24px;transition:.2s;"
                      class="vn-switch-slider"></span>
            </label>
        </div>

        <section class="vn-card vn-otp-block" style="display:none;">
            <div class="vn-card-head"><h3>XÁC THỰC ĐẠI LÝ (OTP)</h3></div>
            <div class="vn-card-body">
                <p class="sub" style="margin:0 0 10px;">
                    Mã OTP 6 số sẽ gửi về email đối tác của đơn này. Mã có hiệu lực <b>2 phút</b>.
                </p>
                <button type="button" class="vn-btn vn-otp-send-btn">Gửi OTP</button>
                <div class="vn-otp-step2" style="display:none; margin-top:12px;">
                    <div class="vn-field">
                        <label>Nhập mã OTP <span class="vn-otp-countdown"
                              style="color:#0e6e6b;font-weight:600;margin-left:8px;"></span></label>
                        <input type="text" class="vn-otp-input" maxlength="6"
                               inputmode="numeric" pattern="[0-9]{6}"
                               placeholder="______"
                               style="letter-spacing:8px;font-size:20px;text-align:center;"/>
                    </div>
                    <button type="button" class="vn-btn vn-btn-block vn-otp-verify-btn">Xác nhận</button>
                </div>
                <div class="vn-otp-msg" style="margin-top:10px;font-size:13px;"></div>
            </div>
        </section>

        <script>
        (function(){
            var root = document.querySelector('.vn-dealer-toggle');
            if (!root) return;
            var token = root.getAttribute('data-token');
            var toggle = document.querySelector('.vn-retail-toggle');
            var slider = document.querySelector('.vn-switch-slider');
            var retailBlock = document.querySelector('.vn-retail-block');
            var otpBlock = document.querySelector('.vn-otp-block');
            var sendBtn = document.querySelector('.vn-otp-send-btn');
            var step2 = document.querySelector('.vn-otp-step2');
            var input = document.querySelector('.vn-otp-input');
            var verifyBtn = document.querySelector('.vn-otp-verify-btn');
            var countdown = document.querySelector('.vn-otp-countdown');
            var msg = document.querySelector('.vn-otp-msg');
            var timer = null;

            function setSlider(on){
                slider.style.background = on ? '#0e6e6b' : '#9ca3af';
            }
            setSlider(true);

            toggle.addEventListener('change', function(){
                var on = toggle.checked;
                setSlider(on);
                if (on) {
                    if (retailBlock) retailBlock.style.display = '';
                    otpBlock.style.display = 'none';
                } else {
                    if (retailBlock) retailBlock.style.display = 'none';
                    otpBlock.style.display = '';
                }
            });

            function rpc(url, payload){
                return fetch(url, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({jsonrpc: '2.0', method: 'call', params: payload || {}})
                }).then(function(r){ return r.json(); }).then(function(d){ return d.result || {}; });
            }

            function startCountdown(sec){
                if (timer) clearInterval(timer);
                var s = sec;
                countdown.textContent = '(' + s + 's)';
                verifyBtn.disabled = false;
                timer = setInterval(function(){
                    s--;
                    if (s &lt;= 0) {
                        clearInterval(timer);
                        countdown.textContent = '(Hết hạn)';
                        verifyBtn.disabled = true;
                    } else {
                        countdown.textContent = '(' + s + 's)';
                    }
                }, 1000);
            }

            sendBtn.addEventListener('click', function(){
                msg.textContent = '';
                sendBtn.disabled = true;
                rpc('/warranty/otp/' + token + '/request').then(function(r){
                    if (r.ok) {
                        step2.style.display = '';
                        msg.style.color = '#0e6e6b';
                        msg.textContent = 'Đã gửi OTP về ' + (r.email_masked || 'email');
                        startCountdown(r.ttl || 120);
                        sendBtn.textContent = 'Gửi lại OTP';
                        sendBtn.disabled = false;
                    } else {
                        msg.style.color = '#b91c1c';
                        msg.textContent = r.error || 'Không gửi được OTP.';
                        sendBtn.disabled = false;
                    }
                }).catch(function(){
                    msg.style.color = '#b91c1c';
                    msg.textContent = 'Lỗi mạng.';
                    sendBtn.disabled = false;
                });
            });

            verifyBtn.addEventListener('click', function(){
                var code = (input.value || '').trim();
                if (!/^\d{6}$/.test(code)) {
                    msg.style.color = '#b91c1c';
                    msg.textContent = 'Mã OTP phải gồm 6 chữ số.';
                    return;
                }
                verifyBtn.disabled = true;
                rpc('/warranty/otp/' + token + '/verify', {code: code}).then(function(r){
                    if (r.ok) {
                        msg.style.color = '#0e6e6b';
                        msg.textContent = 'Xác thực thành công, đang chuyển trang…';
                        if (timer) clearInterval(timer);
                        window.location.reload();
                    } else {
                        msg.style.color = '#b91c1c';
                        msg.textContent = r.error || 'Mã không đúng.';
                        verifyBtn.disabled = false;
                    }
                }).catch(function(){
                    msg.style.color = '#b91c1c';
                    msg.textContent = 'Lỗi mạng.';
                    verifyBtn.disabled = false;
                });
            });
        })();
        </script>
    </template>

    <template id="template_warranty_register_form" name="Đăng ký bảo hành">
        <t t-call="vnop_product_portal.vnoptic_public_layout">
            <t t-set="page_title" t-value="'Đăng ký bảo hành – VNOptic'"/>
            <div class="vn-narrow">
                <h2 class="vn-page-title">Đăng ký bảo hành sản phẩm</h2>

                <t t-call="vnop_warranty.template_warranty_dealer_otp_partial"/>

                <div class="vn-retail-block">
                    <section class="vn-card">
                        <div class="vn-card-head">
                            <h3>THÔNG TIN PHIẾU BẢO HÀNH</h3>
                        </div>
                        <div class="vn-card-body">
                            <div class="vn-info-row">
                                <span class="k">Sản phẩm:</span>
                                <span class="v" t-out="reg.product_id.display_name"/>
                            </div>
                            <div class="vn-info-row">
                                <span class="k">Gói bảo hành:</span>
                                <span class="v">
                                    <t t-out="reg.warranty_id.name"/>
                                    (<t t-out="reg.warranty_id.duration"/>
                                    <t t-out="dict(reg.warranty_id._fields['duration_unit'].selection).get(reg.warranty_id.duration_unit, '')"/>
                                    + <t t-out="reg.warranty_id.bonus_days"/> ngày bonus)
                                </span>
                            </div>
                        </div>
                    </section>

                    <t t-if="error">
                        <div class="vn-alert vn-alert-danger" t-out="error"/>
                    </t>

                    <section class="vn-card">
                        <div class="vn-card-head">
                            <h3>THÔNG TIN KHÁCH HÀNG</h3>
                            <p class="sub">Vui lòng điền chính xác để được hỗ trợ tốt nhất</p>
                        </div>
                        <div class="vn-card-body">
                            <form t-attf-action="/warranty/register/{{ reg.token }}/submit"
                                  method="POST">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <div class="vn-field">
                                    <label>Họ và tên <span class="req">*</span></label>
                                    <input type="text" name="customer_name" required="required"/>
                                </div>
                                <div class="vn-field">
                                    <label>Số điện thoại <span class="req">*</span></label>
                                    <input type="tel" name="customer_phone" required="required"/>
                                </div>
                                <div class="vn-field">
                                    <label>Email</label>
                                    <input type="email" name="customer_email"/>
                                </div>
                                <div class="vn-field">
                                    <label>Địa chỉ</label>
                                    <input type="text" name="customer_address"/>
                                </div>
                                <button type="submit" class="vn-btn vn-btn-block">Đăng ký</button>
                            </form>
                        </div>
                    </section>
                </div>
            </div>
        </t>
    </template>

