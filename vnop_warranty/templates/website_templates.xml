        <t t-call="vnop_product_portal.vnoptic_public_layout">
            <t t-set="page_title" t-value="'Thông tin bảo hành – VNOptic'"/>
            <div class="vn-narrow">
                <h2 class="vn-page-title">Thông tin bảo hành</h2>

                <t t-set="state_label" t-value="dict(reg._fields['state'].selection).get(reg.state, '')"/>

                <section class="vn-card">
                    <div class="vn-card-head">
                        <h3>SẢN PHẨM</h3>
                    </div>
                    <div class="vn-card-body">
                        <div class="vn-info-row">
                            <span class="k">Sản phẩm:</span>
                            <span class="v" t-out="reg.product_id.display_name"/>
                        </div>
                        <div class="vn-info-row">
                            <span class="k">Đơn bán:</span>
                            <span class="v" t-out="reg.sale_order_id.name"/>
                        </div>
                        <div class="vn-info-row">
                            <span class="k">Gói bảo hành:</span>
                            <span class="v">
                                <t t-out="reg.warranty_id.name"/>
                                (<t t-out="reg.warranty_id.duration"/>
                                <t t-out="dict(reg.warranty_id._fields['duration_unit'].selection).get(reg.warranty_id.duration_unit, '')"/>
