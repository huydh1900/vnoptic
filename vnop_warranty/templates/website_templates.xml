                                <span class="k">Khách hàng:</span>
                                <span class="v" t-out="reg.customer_name or '—'"/>
                            </div>
                            <div class="vn-info-row">
                                <span class="k">SĐT:</span>
                                <span class="v" t-out="reg.customer_phone or '—'"/>
                            </div>
                            <div class="vn-info-row">
