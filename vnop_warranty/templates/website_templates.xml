                                    + <t t-out="reg.warranty_id.bonus_days"/> ngày bonus
                                </t>)
                            </span>
                        </div>
                        <div class="vn-info-row">
                            <span class="k">Trạng thái:</span>
                            <span class="v">
                                <b t-out="state_label"/>
                            </span>
                        </div>
                    </div>
