                <!-- Bảo hành bán buôn — luôn hiển thị khi có date_delivered -->
                <section class="vn-card">
                    <div class="vn-card-head">
                        <h3>BẢO HÀNH BÁN BUÔN (TỪ NGÀY XUẤT KHO)</h3>
