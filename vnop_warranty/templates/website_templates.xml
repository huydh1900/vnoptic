    <!-- ============== TRA CỨU BẢO HÀNH ============== -->

    <template id="template_warranty_check_form" name="Tra cứu bảo hành">
        <t t-call="vnop_product_portal.vnoptic_public_layout">
            <t t-set="page_title" t-value="'Tra cứu bảo hành – VNOptic'"/>
            <div class="vn-narrow">
                <h2 class="vn-page-title">Tra cứu bảo hành</h2>

                <t t-if="error">
                    <div class="vn-alert vn-alert-danger" t-out="error"/>
                </t>

                <!-- Toggle: Khách lẻ (mặc định) vs Nhà bán buôn (OTP) -->
                <div class="vn-check-toggle"
                     style="display:flex; justify-content:space-between; align-items:center;
                            background:#fff; border:1px solid #e5e7eb; border-radius:6px;
                            padding:10px 14px; margin-bottom:12px;">
                    <div>
                        <b>Nhà bán buôn</b>
                        <div class="sub" style="font-size:12px;color:#6b7280;">
                            Bật nếu bạn là đại lý muốn xem BH bán buôn (xác thực OTP qua email).
                        </div>
                    </div>
                    <label class="vn-switch" style="position:relative;display:inline-block;width:46px;height:24px;">
                        <input type="checkbox" class="vn-wholesale-toggle"
                               style="opacity:0;width:0;height:0;"/>
                        <span style="position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;
                                     background:#9ca3af;border-radius:24px;transition:.2s;"
                              class="vn-check-switch-slider"></span>
                    </label>
                </div>

                <section class="vn-card vn-check-retail-block">
                    <div class="vn-card-body">
                        <p class="sub" style="margin-bottom: 12px;">
                            Nhập <b>Mã phiếu</b> hoặc <b>Số điện thoại</b> đã đăng ký (chỉ cần một trong hai).
                        </p>
                        <form action="/warranty/check/lookup" method="POST">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <div class="vn-field">
                                <label>Số điện thoại đã đăng ký</label>
                                <input type="tel" name="phone"/>
                            </div>
                            <div class="vn-field">
                                <label>Mã phiếu bảo hành</label>
                                <input type="text" name="token"
                                       placeholder="Mã in trên tem hoặc nhận khi đăng ký"/>
                            </div>
                            <button type="submit" class="vn-btn vn-btn-block">Tra cứu</button>
                        </form>
                    </div>
                </section>

                <!-- Block bán buôn: nhập mã phiếu -> gửi OTP -> xác thực -->
                <section class="vn-card vn-check-wholesale-block" style="display:none;">
                    <div class="vn-card-head"><h3>XÁC THỰC ĐẠI LÝ (OTP)</h3></div>
                    <div class="vn-card-body">
                        <div class="vn-field">
                            <label>Mã phiếu bảo hành <span class="req">*</span></label>
                            <input type="text" class="vn-ws-token"
                                   placeholder="Mã in trên tem hoặc nhận khi đăng ký"/>
                        </div>
                        <p class="sub" style="margin:0 0 10px;">
                            Mã OTP 6 số sẽ gửi về email đối tác của đơn này. Mã có hiệu lực <b>2 phút</b>.
                        </p>
                        <button type="button" class="vn-btn vn-ws-send-btn">Gửi OTP</button>
                        <div class="vn-ws-step2" style="display:none; margin-top:12px;">
                            <div class="vn-field">
                                <label>Nhập mã OTP <span class="vn-ws-countdown"
                                      style="color:#0e6e6b;font-weight:600;margin-left:8px;"></span></label>
                                <input type="text" class="vn-ws-input" maxlength="6"
                                       inputmode="numeric" pattern="[0-9]{6}"
                                       placeholder="______"
                                       style="letter-spacing:8px;font-size:20px;text-align:center;"/>
                            </div>
                            <button type="button" class="vn-btn vn-btn-block vn-ws-verify-btn">Xác nhận</button>
                        </div>
                        <div class="vn-ws-msg" style="margin-top:10px;font-size:13px;"></div>
                    </div>
                </section>

                <script>
                (function(){
                    var root = document.querySelector('.vn-check-toggle');
                    if (!root) return;
                    var toggle = document.querySelector('.vn-wholesale-toggle');
                    var slider = document.querySelector('.vn-check-switch-slider');
                    var retailBlock = document.querySelector('.vn-check-retail-block');
                    var wsBlock = document.querySelector('.vn-check-wholesale-block');
                    var tokenInput = document.querySelector('.vn-ws-token');
                    var sendBtn = document.querySelector('.vn-ws-send-btn');
                    var step2 = document.querySelector('.vn-ws-step2');
                    var input = document.querySelector('.vn-ws-input');
                    var verifyBtn = document.querySelector('.vn-ws-verify-btn');
                    var countdown = document.querySelector('.vn-ws-countdown');
                    var msg = document.querySelector('.vn-ws-msg');
                    var timer = null;

                    toggle.addEventListener('change', function(){
                        var on = toggle.checked;
                        slider.style.background = on ? '#0e6e6b' : '#9ca3af';
                        retailBlock.style.display = on ? 'none' : '';
                        wsBlock.style.display = on ? '' : 'none';
                    });

                    function rpc(url, payload){
                        return fetch(url, {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({jsonrpc: '2.0', method: 'call', params: payload || {}})
                        }).then(function(r){ return r.json(); }).then(function(d){ return d.result || {}; });
                    }

                    function startCountdown(sec){
                        if (timer) clearInterval(timer);
                        var s = sec;
                        countdown.textContent = '(' + s + 's)';
                        verifyBtn.disabled = false;
                        timer = setInterval(function(){
                            s--;
                            if (s &lt;= 0) {
                                clearInterval(timer);
                                countdown.textContent = '(Hết hạn)';
                                verifyBtn.disabled = true;
                            } else {
                                countdown.textContent = '(' + s + 's)';
                            }
                        }, 1000);
                    }

                    sendBtn.addEventListener('click', function(){
                        var token = (tokenInput.value || '').trim();
                        msg.textContent = '';
                        if (!token) {
                            msg.style.color = '#b91c1c';
                            msg.textContent = 'Vui lòng nhập Mã phiếu bảo hành.';
                            return;
                        }
                        sendBtn.disabled = true;
                        rpc('/warranty/otp/' + encodeURIComponent(token) + '/request').then(function(r){
                            if (r.ok) {
                                step2.style.display = '';
                                msg.style.color = '#0e6e6b';
                                msg.textContent = 'Đã gửi OTP về ' + (r.email_masked || 'email');
                                startCountdown(r.ttl || 120);
                                sendBtn.textContent = 'Gửi lại OTP';
                                sendBtn.disabled = false;
                            } else {
                                msg.style.color = '#b91c1c';
                                msg.textContent = r.error || 'Không gửi được OTP.';
                                sendBtn.disabled = false;
                            }
                        }).catch(function(){
                            msg.style.color = '#b91c1c';
                            msg.textContent = 'Lỗi mạng.';
                            sendBtn.disabled = false;
                        });
                    });

                    verifyBtn.addEventListener('click', function(){
                        var token = (tokenInput.value || '').trim();
                        var code = (input.value || '').trim();
                        if (!/^\d{6}$/.test(code)) {
                            msg.style.color = '#b91c1c';
                            msg.textContent = 'Mã OTP phải gồm 6 chữ số.';
                            return;
                        }
                        verifyBtn.disabled = true;
                        rpc('/warranty/otp/' + encodeURIComponent(token) + '/verify', {code: code}).then(function(r){
                            if (r.ok) {
                                msg.style.color = '#0e6e6b';
                                msg.textContent = 'Xác thực thành công, đang chuyển trang…';
                                if (timer) clearInterval(timer);
                                window.location = '/warranty/register/' + encodeURIComponent(token);
                            } else {
                                msg.style.color = '#b91c1c';
                                msg.textContent = r.error || 'Mã không đúng.';
                                verifyBtn.disabled = false;
                            }
                        }).catch(function(){
                            msg.style.color = '#b91c1c';
                            msg.textContent = 'Lỗi mạng.';
                            verifyBtn.disabled = false;
                        });
                    });
                })();
                </script>
            </div>
        </t>
    </template>

